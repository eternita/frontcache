<?xml version="1.0" encoding="UTF-8" ?>

<!--
this config the same as in logback.xml in classpath. Use this one if you want to override default configuration.
uncomment it in frontcache.properties:

front-cache.request-logs-config=fc-logback.xml
-->
<configuration>

    <!-- ReguestLoggerFile for REQUEST LOGS ONLY -->
	<appender name="ReguestLoggerFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>TRACE</level>
			<OnMatch>NEUTRAL</OnMatch>
			<OnMismatch>DENY</OnMismatch>
		</filter>

		<File>${frontcache.home}/logs/frontcache-requests.log</File>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<FileNamePattern>${frontcache.home}/logs/frontcache-requests-%d{yyyy-MM-dd}.log.zip</FileNamePattern>
		</rollingPolicy>
		<encoder>
			  <pattern>%msg%n</pattern>
		</encoder>
	</appender>

    <!-- FailedRequestLoggerFile for NON-SUCCESSFUL REQUEST LOGS ONLY (short-circuited/timeout/rejected/bad-request/failure) -->
	<appender name="FailedRequestLoggerFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>TRACE</level>
			<OnMatch>NEUTRAL</OnMatch>
			<OnMismatch>DENY</OnMismatch>
		</filter>

		<File>${frontcache.home}/logs/frontcache-failed-requests.log</File>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<FileNamePattern>${frontcache.home}/logs/frontcache-failed-requests-%d{yyyy-MM-dd}.log.zip</FileNamePattern>
		</rollingPolicy>
		<encoder>
			  <pattern>%msg%n</pattern>
		</encoder>
	</appender>

    <!-- FallbackLoggerFile for FALLBACK LOGS ONLY -->
    <appender name="FallbackLoggerFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>TRACE</level>
            <OnMatch>NEUTRAL</OnMatch>
            <OnMismatch>DENY</OnMismatch>
        </filter>

        <File>${frontcache.home}/logs/fallback.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <FileNamePattern>${frontcache.home}/logs/fallback-%d{yyyy-MM-dd}.log.zip</FileNamePattern>
        </rollingPolicy>
        <encoder>
              <pattern>%msg%n</pattern>
        </encoder>
    </appender>


    <!-- HttpPoolFile for the HTTP (origin) CONNECTION POOL SNAPSHOT ONLY - one line every 5 min -->
    <appender name="HttpPoolFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>${frontcache.home}/frontcache-logs/http-pool.info</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <FileNamePattern>${frontcache.home}/frontcache-logs/http-pool-%d{yyyy-MM-dd}.info.zip</FileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %msg%n</pattern>
        </encoder>
    </appender>


	<appender name="Error" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!-- WARN and above. This was LevelFilter(ERROR), which matched ERROR *exactly* - and since no
		     other appender picks up WARN either, every WARN was silently discarded. That hid the L2
		     Lucene lock diagnostics ("write lock is stale", "Deleted stale L2 write lock", "recovered
		     automatically") that explained a 25h production wedge; they survived only in journald. -->
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>WARN</level>
		</filter>

		<File>${frontcache.home}/logs/error.log</File>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<FileNamePattern>${frontcache.home}/logs/error-%d{yyyy-MM-dd}.log.zip</FileNamePattern>
		</rollingPolicy>
		<encoder>
			  <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="Info" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>INFO</level>
			<OnMatch>NEUTRAL</OnMatch>
			<OnMismatch>DENY</OnMismatch>
		</filter>
		<File>${frontcache.home}/logs/info.log</File>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<FileNamePattern>${frontcache.home}/logs/info-%d{yyyy-MM-dd}.log.zip</FileNamePattern>
		</rollingPolicy>
		<encoder>
             <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>


  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>



	<root>
        <level value="INFO" />
		<appender-ref ref="Error" />
		<appender-ref ref="Info" />
		<appender-ref ref="STDOUT" />
	</root>

	<!-- for request logger -->
	<logger name="org.frontcache.reqlog.RequestLogger">
	    <level value="TRACE" />
		<appender-ref ref="ReguestLoggerFile" />
	</logger>

	<!-- for non-successful requests only (additivity=false -> kept out of the root/info logs) -->
	<logger name="frontcache.failed-requests" additivity="false">
	    <level value="TRACE" />
		<appender-ref ref="FailedRequestLoggerFile" />
	</logger>

    <!-- for fallback logger -->
    <logger name="org.frontcache.hystrix.FallbackLogger">
        <level value="TRACE" />
        <appender-ref ref="FallbackLoggerFile" />
    </logger>

    <!-- HTTP origin connection pool snapshot, every 5 min (additivity=false -> kept out of info.log;
         a near-exhausted pool still warns separately into error.log) -->
    <logger name="frontcache.http-pool" additivity="false">
        <level value="INFO" />
        <appender-ref ref="HttpPoolFile" />
    </logger>

</configuration>
