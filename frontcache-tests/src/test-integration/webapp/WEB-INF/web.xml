<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         xmlns:web="https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee">
             
	<display-name>front-cache in standalone mode</display-name>
	<description>front-cache in standalone mode (is running inside embedded Jetty)</description>

    <servlet>
        <servlet-name>FrontCacheServlet</servlet-name>
        <servlet-class>org.frontcache.FrontCacheServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>FrontCacheIOServlet</servlet-name>
        <servlet-class>org.frontcache.io.FrontCacheIOServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrontCacheServlet</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
	
    <servlet-mapping>
        <servlet-name>FrontCacheIOServlet</servlet-name>
        <url-pattern>/frontcache-io</url-pattern>
    </servlet-mapping>

    <!-- The metrics stream the console reads. Mapped here so the e2e suite actually covers it: it was
         previously only mapped in the real server webapp, so nothing in the test suite ever hit the
         endpoint and the empty thread-pool panel went unnoticed for as long as it did. An exact
         url-pattern wins over FrontCacheServlet's /*. -->
    <servlet>
        <servlet-name>HystrixMetricsStreamServlet</servlet-name>
        <servlet-class>org.frontcache.hystrix.HystrixStreamSecurityWrapperServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HystrixMetricsStreamServlet</servlet-name>
        <url-pattern>/hystrix.stream</url-pattern>
    </servlet-mapping>

    <!-- Prometheus scrape, so the e2e suite covers the gating and the exposition format. -->
    <servlet>
        <servlet-name>FcMetricsServlet</servlet-name>
        <servlet-class>org.frontcache.metrics.FcMetricsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FcMetricsServlet</servlet-name>
        <url-pattern>/fc-metrics</url-pattern>
    </servlet-mapping>
    
</web-app>