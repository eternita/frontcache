/.idea
/.claude
/build/
/.gradle/
/gradle.properties
.DS_Store
/target/
/distribution/
/**/target/
/**/build/
/frontcache-server/server/frontcache-base/webapps/
/frontcache-server/server/lib/
/frontcache-tests/FRONTCACHE_HOME_FILTER/cache/
/frontcache-tests/FRONTCACHE_HOME_FILTER/logs/
/frontcache-tests/FRONTCACHE_HOME_STANDALONE/cache/
/frontcache-tests/FRONTCACHE_HOME_STANDALONE/logs/
# the unit suite starts a real FrontCacheEngine against this home and leaves a Lucene index behind
/frontcache-core/src/test/resources/fallback-home/cache/

# Written at runtime, not by hand: fallbacks.conf gives fallback2.txt an init URL
/frontcache-tests/FRONTCACHE_HOME_FILTER/fallbacks/fallback2.txt
/frontcache-tests/FRONTCACHE_HOME_STANDALONE/fallbacks/fallback2.txt

# set-config keeps the previous content as conf/<file>.backup-<timestamp> before it writes. The conf
# dirs of both e2e homes ARE checked in, so without this a config-write test dirties the working tree.
/frontcache-tests/FRONTCACHE_HOME_FILTER/conf/*.backup-*
/frontcache-tests/FRONTCACHE_HOME_STANDALONE/conf/*.backup-*
/_ignored/
