<?xml version="1.0" encoding="UTF-8" ?>

<!--
Logback configuration for the Frontcache console.
Only ERROR (and above) is emitted to stdout (sysout); lower levels are dropped.
Wired in via -Dlogback.configurationFile=.../config/fc-logback.xml (see the
:frontcache-console appRun task in build.gradle).
-->
<configuration>

	<!-- Console (stdout) — ERROR and above only. -->
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>

</configuration>
