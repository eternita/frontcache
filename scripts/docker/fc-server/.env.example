# fc-server configuration. Copy to `.env` and edit.
#   cp .env.example .env

# Backend origin for the non-cached paths (images, static assets, dynamic endpoints).
ORIGIN_HOST=origin.example.com

# Space-separated paths proxied straight to ORIGIN_HOST (everything else is cached by Frontcache).
ORIGIN_PATHS=/o9r/ /fs/ /pi/ /st/ /images/ /css/ /js/ /page-cache/

# Published host ports (container always listens on 80/443 internally).
FC_HTTP_PORT=80
FC_HTTPS_PORT=443

# Internal Frontcache HTTP port (embedded Jetty 12 is HTTP-only; nginx fronts TLS).
FRONTCACHE_HTTP_PORT=9080

# Jetty keystore credentials — defaults match the bundled demo keystore.
KEYSTORE_STOREPASS=storepwd
KEYSTORE_KEYPASS=keypwd
KEYSTORE_ALIAS=jetty
