# Frontcache stack configuration. Copy to `.env` and edit.
#   cp .env.example .env

# ---- images ------------------------------------------------------------------
# The version tag to run. Name an exact release; `latest` is deliberately not the default.
# Use `local` with start-fc-server.sh to run images you built from this checkout.
FC_VERSION=local

# Override only to pull from a different namespace or a private mirror.
#FC_IMAGE_SERVER=pavlikovskiy/frontcache-server
#FC_IMAGE_CONSOLE=pavlikovskiy/frontcache-console

# ---- origin ------------------------------------------------------------------
# Backend for the non-cached paths (images, static assets, dynamic endpoints), and the
# origin Frontcache forwards cache misses to.
#
# Leave this EMPTY to let the mounted frontcache.properties own front-cache.origin-host -
# the entrypoint then reads the value from the file and never rewrites it. Set it, and it
# is authoritative: it gets written into the properties file on every start.
ORIGIN_HOST=

# Space-separated paths nginx proxies straight to ORIGIN_HOST (everything else is cached).
ORIGIN_PATHS=/o9r/ /fs/ /pi/ /st/ /images/ /css/ /js/ /page-cache/

# ---- ports -------------------------------------------------------------------
# Published host ports (the container always listens on 80/443 internally).
FC_HTTP_PORT=80
FC_HTTPS_PORT=443

# Internal Frontcache HTTP port (embedded Jetty 12 is HTTP-only; nginx fronts TLS).
FRONTCACHE_HTTP_PORT=9080

# ---- config location ---------------------------------------------------------
# Default is the `fc-conf` named volume. Point this at a host directory to own the config
# on the host instead - recommended for production. The directory may start empty; the
# entrypoint seeds the shipped defaults into it.
#FC_CONF_DIR=./conf
#FC_CONSOLE_CONF_DIR=./console-conf

# ---- TLS ---------------------------------------------------------------------
# Credentials of the bundled Jetty DEMO keystore (self-signed - replace for production, by
# mounting a real frontcache.crt/frontcache.key pair at /etc/nginx/ssl).
KEYSTORE_STOREPASS=storepwd
KEYSTORE_KEYPASS=keypwd
KEYSTORE_ALIAS=jetty

# ---- console (profile: console) ----------------------------------------------
# Nodes the console monitors, comma-separated. FC_SITE_KEY must match each node's
# front-cache.site-key or the nodes reject the console's calls.
FC_NODES=http://fc-server:9080/
FC_SITE_KEY=

# The console has NO authentication and can invalidate the whole fleet. Keep the bind
# address on loopback and reach it over an ssh tunnel, or put an authenticating proxy
# in front of it.
FC_CONSOLE_BIND=127.0.0.1
FC_CONSOLE_PORT=7080
