# Front-door example configuration. Copy to `.env` and edit.
#   cp .env.example .env

# ---- images ------------------------------------------------------------------
# Pin an exact Frontcache release. From 2.6.0 the plain tag IS the no-nginx image; on 2.5.x
# and earlier you want the `-slim` one, because the plain tag was nginx + Frontcache.
FC_IMAGE=pavlikovskiy/frontcache-server:2.8.0
NGINX_IMAGE=nginx:1.27

# ---- your app ----------------------------------------------------------------
# The backend. `origin` is the stand-in service in docker-compose.yml - replace it with your
# own host and delete that service.
ORIGIN_HOST=origin

# http for the stand-in origin (it has no certificate). A real origin should be https.
ORIGIN_SCHEME=http

# Paths nginx proxies STRAIGHT to the origin, bypassing the cache entirely. Everything else
# goes through Frontcache. Space-separated, trailing slash.
ORIGIN_PATHS=/images/ /css/ /js/

# ---- ports -------------------------------------------------------------------
# Published host ports. nginx always listens on 80/443 inside the container.
FD_HTTP_PORT=80
FD_HTTPS_PORT=443

# Frontcache's port on the compose network. Not published to the host.
FRONTCACHE_HTTP_PORT=9080

# ---- TLS ---------------------------------------------------------------------
# Default: a self-signed certificate generated into the `fd-tls` volume on first start.
# For a real certificate, point this at a host directory holding frontcache.crt and
# frontcache.key - existing files are never overwritten.
#FD_TLS_DIR=./ssl
TLS_CN=localhost

# ---- config ------------------------------------------------------------------
# Frontcache config lives in the `fd-conf` volume by default. Point this at a host directory
# to own it yourself - recommended for anything real. It may start empty; the image seeds
# the shipped defaults into it.
#FD_CONF_DIR=./conf
